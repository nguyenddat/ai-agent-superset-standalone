DATABASE_URL=postgresql+psycopg://app:change-me@localhost:5432/ai_agent
POSTGRES_USER=app
POSTGRES_PASSWORD=change-me
POSTGRES_DB=ai_agent
QDRANT_PORT=6333
QDRANT_URL=http://localhost:6333
TEXT2SQL_COLLECTION=text2sql_semantics_v1
TEXT2SQL_EMBEDDING_MODEL=openai/text-embedding-3-small
TEXT2SQL_EMBEDDING_DIMENSIONS=1536
# Ingestion worker: parallel jobs, retry policy, per-topic reconcile intervals in seconds (>= 30), e.g. metric=300,own_knowledge=60
TEXT2SQL_WORKER_CONCURRENCY=4
TEXT2SQL_WORKER_POLL_SECONDS=2
TEXT2SQL_JOB_MAX_ATTEMPTS=3
TEXT2SQL_JOB_TIMEOUT_SECONDS=900
TEXT2SQL_JOB_RETENTION_DAYS=7
TEXT2SQL_TOPIC_INTERVALS=
# Optional Jev reranking (used when the MCP tool search_metrics is called with rerank=true; same OPENROUTER_API_KEY)
# Metric queries run by the MCP tool query_metric on the registered source database (read-only transaction)
TEXT2SQL_QUERY_TIMEOUT_SECONDS=15
TEXT2SQL_QUERY_MAX_ROWS=200
# Route POST /api/v1/text2sql/chat: max (PII-masked) rows per query sent to the analysis LLM
TEXT2SQL_CHAT_MAX_ROWS_TO_LLM=50
# Conversation history: max (PII-masked) rows stored per query in a turn
CONVERSATION_MAX_STORED_ROWS=200
TEXT2SQL_RERANK_MODEL=typesafe/jev-1.14
TEXT2SQL_RERANK_POOL=20
TEXT2SQL_ASK_METRIC_MIN_SCORE=0.6
TEXT2SQL_FIELD_MIN_SCORE=0.6
TEXT2SQL_RERANK_CONCURRENCY=8
TEXT2SQL_RERANK_TIMEOUT_SECONDS=20
# Generate a key with: uv run python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
CONNECTION_ENCRYPTION_KEY=
# AI autofill and Text2SQL embeddings (OpenRouter, OpenAI-compatible API)
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=openai/gpt-6-luna
# Optional read-only import from Superset (an account allowed to list users, databases and datasets)
SUPERSET_URL=
SUPERSET_USERNAME=
SUPERSET_PASSWORD=
# Server-side keys for AI Agent push/read and administrator review of private knowledge.
OWN_KNOWLEDGE_AGENT_KEY=
OWN_KNOWLEDGE_ADMIN_KEY=
OWN_KNOWLEDGE_REVIEW_PASSWORD=
