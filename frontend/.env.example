NEXT_PUBLIC_API_URL=http://localhost:8000
# Server-only: the own-knowledge review proxy calls the backend at API_URL (falls back to NEXT_PUBLIC_API_URL)
# and adds this key itself, so it never reaches the browser. Leave empty to turn the review tab off.
API_URL=
OWN_KNOWLEDGE_ADMIN_KEY=
OWN_KNOWLEDGE_REVIEW_PASSWORD=
