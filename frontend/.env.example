# Server-only. The browser calls /api/v1/* on this app; app/api/v1/[...path] forwards to the backend at
# API_URL (default http://localhost:8000) and adds TEXT2SQL_SERVICE_KEY, which must equal the backend's.
# Without the key every page answers 503. The own-knowledge review proxy adds its own admin key; leave
# those empty to turn the review tab off. No key ever reaches the browser.
API_URL=
TEXT2SQL_SERVICE_KEY=
OWN_KNOWLEDGE_ADMIN_KEY=
OWN_KNOWLEDGE_REVIEW_PASSWORD=
